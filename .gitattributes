# Normalize line endings so Windows, macOS and Linux checkouts don't produce
# phantom diffs where every line in a file looks changed.
#
# `text=auto` lets Git detect text files and store them with LF in the
# repository. `eol=lf` checks them back out as LF everywhere, which keeps the
# committed history stable no matter which OS the working copy lives on.
* text=auto eol=lf

# Binary files must never be line-ending converted or they get corrupted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
